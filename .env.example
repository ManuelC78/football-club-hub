# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/fch_dev
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/fch_test

# ── Authentication ─────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# ── Email (SendGrid / SMTP) ────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@footballclubhub.com

# ── Storage (AWS S3 / Cloudflare R2) ──────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=eu-west-1
S3_BUCKET_NAME=football-club-hub-assets

# ── Stripe Payments ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Analytics ──────────────────────────────────────────────
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Frontend URL ───────────────────────────────────────────
CLIENT_URL=http://localhost:3001
